# Example environment variables for inkos-api.
# Copy to .env or export in your shell before launching the server.

# LLM provider (any OpenAI-compatible base URL).
INKOS_LLM_PROVIDER=openai
INKOS_LLM_SERVICE=openai
INKOS_LLM_BASE_URL=https://api.openai.com/v1
INKOS_LLM_MODEL=gpt-4o

# Optional second service.
# INKOS_LLM_SERVICE=moonshot
# INKOS_LLM_BASE_URL=https://api.moonshot.cn/v1
# INKOS_LLM_MODEL=kimi-k2.5
